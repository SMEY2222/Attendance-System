<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#EEF4F0;--surface:#FFFFFF;--card:#FFFFFF;--border:#D6E4DB;
  --text:#0E1F16;--muted:#6B8C75;--accent:#1A7A52;--accent2:#F4A228;
  --green:#1A7A52;--red:#D63F3F;--amber:#D4860A;
  --teal-light:#E4F2EC;--radius:14px;
  --shadow:0 2px 16px rgba(26,122,82,.09);
  --shadow-md:0 8px 32px rgba(26,122,82,.14);
  --dots:url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='2' cy='2' r='1.5' fill='%231A7A52' fill-opacity='0.12'/%3E%3C/svg%3E");
}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes scaleIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}
@keyframes shimmer{0%,100%{opacity:.5}50%{opacity:1}}

body{background:var(--bg);color:var(--text);font-family:'Sora',sans-serif;min-height:100vh}

/* ─── Auth ─── */
.auth-wrap{min-height:100vh;display:flex;align-items:stretch}

/* Left decorative panel */
.auth-left{
  flex:0 0 440px;
  background:linear-gradient(160deg,#0E5C38 0%,#1A7A52 55%,#229966 100%);
  padding:52px 44px;display:flex;flex-direction:column;justify-content:space-between;
  position:relative;overflow:hidden;
}
.auth-left::before{content:'';position:absolute;inset:0;background:var(--dots);opacity:1}
/* Large decorative rings */
.auth-left::after{
  content:'';position:absolute;bottom:-80px;right:-80px;
  width:320px;height:320px;border-radius:50%;
  border:40px solid rgba(255,255,255,.07);
}
.auth-left-top{position:relative;z-index:1}
.auth-brand{display:flex;align-items:center;gap:14px;margin-bottom:52px}
.auth-brand-icon{
  width:52px;height:52px;background:rgba(255,255,255,.18);
  border-radius:16px;display:grid;place-items:center;color:#fff;
  border:1.5px solid rgba(255,255,255,.35);
  box-shadow:0 0 0 6px rgba(255,255,255,.06);
}
.auth-brand h1{font-family:'Lora',serif;font-size:26px;font-weight:700;color:#fff;letter-spacing:-.02em}
.auth-brand span{font-size:11px;color:rgba(255,255,255,.6);display:block;margin-top:-2px;letter-spacing:.08em;text-transform:uppercase}
.auth-hero{color:#fff;position:relative;z-index:1}
.auth-hero h2{font-family:'Lora',serif;font-size:34px;font-weight:600;line-height:1.3;margin-bottom:14px;letter-spacing:-.02em}
.auth-hero p{font-size:14px;color:rgba(255,255,255,.7);line-height:1.75}
/* Inner ring accent */
.auth-ring{
  position:absolute;bottom:60px;right:40px;
  width:140px;height:140px;border-radius:50%;
  border:2px solid rgba(255,255,255,.12);z-index:0;
}
.auth-stats{display:flex;gap:12px;position:relative;z-index:1;margin-top:44px;flex-wrap:wrap}
.auth-stat{
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2);
  border-radius:14px;padding:16px 20px;
  backdrop-filter:blur(4px);
  flex:1;min-width:90px;
}
.auth-stat-val{font-family:'Lora',serif;font-size:24px;font-weight:700;color:#fff}
.auth-stat-lbl{font-size:10px;color:rgba(255,255,255,.6);margin-top:3px;letter-spacing:.06em;text-transform:uppercase}

/* Right form panel */
.auth-right{
  flex:1;display:flex;align-items:center;justify-content:center;
  padding:48px 44px;background:var(--bg);
}
.auth-card{width:100%;max-width:400px;animation:fadeUp .5s ease both}
.auth-card-title{
  font-family:'Lora',serif;font-size:30px;font-weight:700;
  margin-bottom:6px;color:var(--text);letter-spacing:-.03em;
}
.auth-card-sub{font-size:14px;color:var(--muted);margin-bottom:28px;line-height:1.6}

.auth-tabs{
  display:flex;gap:4px;background:var(--border);
  border-radius:12px;padding:4px;margin-bottom:28px;
}
.auth-tab{
  flex:1;padding:10px;border:none;border-radius:9px;cursor:pointer;
  font-family:'Sora',sans-serif;font-size:13px;font-weight:600;
  transition:all .22s;background:transparent;color:var(--muted);
}
.auth-tab.active{
  background:var(--surface);color:var(--accent);
  box-shadow:0 2px 10px rgba(26,122,82,.15);
}

/* Fields */
.field{margin-bottom:18px}
.field label{
  display:block;font-size:11px;font-weight:700;color:var(--muted);
  letter-spacing:.07em;text-transform:uppercase;margin-bottom:7px;
}
.field-wrap{position:relative}
.field input,.field select{
  width:100%;padding:12px 16px;
  background:var(--surface);border:1.5px solid var(--border);
  border-radius:11px;color:var(--text);
  font-family:'Sora',sans-serif;font-size:14px;outline:none;
  transition:border .2s,box-shadow .2s;
}
.field input:focus,.field select:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(26,122,82,.12);
}
.field input::placeholder{color:#A8C4B0}

/* Password toggle */
.pwd-toggle{
  position:absolute;right:12px;top:50%;transform:translateY(-50%);
  background:none;border:none;cursor:pointer;color:var(--muted);
  padding:4px;display:flex;align-items:center;
}
/* Strength meter */
.strength-wrap{margin-top:9px}
.strength-bars{display:flex;gap:5px;height:5px}
.strength-bar{flex:1;border-radius:4px;background:var(--border);transition:background .3s,transform .3s}
.strength-bar.weak{background:#D63F3F}
.strength-bar.fair{background:#D4860A}
.strength-bar.good{background:#1A7A52}
.strength-bar.strong{background:#1A7A52}
.strength-label{font-size:11px;color:var(--muted);margin-top:6px;font-weight:600;transition:color .3s}
.pwd-rules{margin-top:9px;display:flex;flex-direction:column;gap:4px}
.pwd-rule{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;transition:color .2s}
.pwd-rule.ok{color:var(--green)}
.pwd-rule svg{flex-shrink:0;transition:stroke .2s}

/* Buttons */
.btn-primary{
  width:100%;padding:14px;
  background:linear-gradient(135deg,#1A7A52,#229966);
  color:#fff;border:none;border-radius:11px;
  font-family:'Sora',sans-serif;font-size:15px;font-weight:700;
  cursor:pointer;transition:all .22s;letter-spacing:.01em;
  box-shadow:0 4px 16px rgba(26,122,82,.3);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,122,82,.38)}
.btn-primary:active{transform:translateY(0);box-shadow:0 2px 8px rgba(26,122,82,.2)}

/* Messages */
.err-msg{
  color:#b82e2e;font-size:13px;margin-bottom:14px;
  padding:11px 14px;background:#FDF1F1;
  border-radius:10px;border:1px solid #F3C0C0;
  display:flex;align-items:center;gap:9px;font-weight:500;
}
.success-msg{
  color:#156641;font-size:13px;margin-bottom:14px;
  padding:11px 14px;background:#EBF7F1;
  border-radius:10px;border:1px solid #A8DBBF;
  display:flex;align-items:center;gap:9px;font-weight:500;
}

.auth-divider{text-align:center;font-size:12px;color:var(--muted);margin:20px 0;position:relative}
.auth-divider::before,.auth-divider::after{content:'';position:absolute;top:50%;width:calc(50% - 30px);height:1px;background:var(--border)}
.auth-divider::before{left:0}
.auth-divider::after{right:0}

/* ─── App Layout ─── */
.app-layout{display:flex;min-height:100vh}

/* Sidebar */
.sidebar{
  width:240px;
  background:linear-gradient(180deg,#0D5234 0%,#1A7A52 100%);
  display:flex;flex-direction:column;padding:26px 14px;
  flex-shrink:0;position:relative;overflow:hidden;
}
.sidebar::before{content:'';position:absolute;inset:0;background:var(--dots);opacity:.6}
/* Sidebar glow blob */
.sidebar::after{
  content:'';position:absolute;bottom:-60px;left:-60px;
  width:200px;height:200px;border-radius:50%;
  background:rgba(255,255,255,.04);
}
.sidebar-logo{
  display:flex;align-items:center;gap:11px;
  margin-bottom:38px;padding:0 8px;position:relative;z-index:1;
}
.sidebar-logo-icon{
  width:40px;height:40px;
  background:rgba(255,255,255,.16);border-radius:12px;
  display:grid;place-items:center;color:#fff;
  border:1.5px solid rgba(255,255,255,.28);flex-shrink:0;
}
.sidebar-logo h2{font-family:'Lora',serif;font-size:18px;font-weight:700;color:#fff;letter-spacing:-.02em}
.sidebar-logo span{font-size:10px;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:.07em}
.sidebar-section-title{
  font-size:10px;font-weight:700;color:rgba(255,255,255,.45);
  letter-spacing:.12em;text-transform:uppercase;padding:0 10px;
  margin-bottom:8px;position:relative;z-index:1;
}
.sidebar-spacer{flex:1}
.sidebar-user{
  display:flex;align-items:center;gap:10px;padding:12px 10px;
  background:rgba(255,255,255,.11);border-radius:12px;margin-bottom:10px;
  border:1px solid rgba(255,255,255,.16);position:relative;z-index:1;
}
.sidebar-avatar{
  width:36px;height:36px;border-radius:10px;
  background:var(--accent2);display:grid;place-items:center;
  font-size:13px;font-weight:700;color:#fff;flex-shrink:0;
  box-shadow:0 2px 8px rgba(0,0,0,.2);
}
.sidebar-username{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#fff}
.sidebar-role{font-size:10px;color:rgba(255,255,255,.55);text-transform:capitalize;margin-top:1px}
.sidebar-nav-btn{
  display:flex;align-items:center;gap:10px;padding:11px 12px;
  border-radius:11px;border:none;cursor:pointer;
  font-family:'Sora',sans-serif;font-size:13px;font-weight:600;
  margin-bottom:4px;background:transparent;color:rgba(255,255,255,.6);
  width:100%;transition:all .2s;position:relative;z-index:1;
}
.sidebar-nav-btn.active{
  background:rgba(255,255,255,.17);color:#fff;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.12);
}
.sidebar-nav-btn:hover:not(.active){color:#fff;background:rgba(255,255,255,.09)}
.sidebar-logout{
  display:flex;align-items:center;gap:9px;width:100%;padding:10px 10px;
  border:none;background:transparent;color:rgba(255,255,255,.45);
  cursor:pointer;border-radius:10px;font-family:'Sora',sans-serif;
  font-size:13px;font-weight:600;transition:all .2s;position:relative;z-index:1;
}
.sidebar-logout:hover{background:rgba(214,63,63,.2);color:#ffaaaa}

/* ─── Main ─── */
.main{flex:1;overflow-y:auto;background:var(--bg)}
.main-header{
  padding:32px 36px 0;display:flex;align-items:center;
  justify-content:space-between;
}
.main-header h1{font-family:'Lora',serif;font-size:28px;font-weight:700;letter-spacing:-.03em}
.main-header p{color:var(--muted);font-size:14px;margin-top:4px}
.content{padding:24px 36px 56px}

/* ─── School Banner ─── */
.school-banner{
  background:linear-gradient(125deg,#1A7A52 0%,#156641 60%,#0D5234 100%);
  border-radius:18px;padding:22px 28px;
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:10px;overflow:hidden;position:relative;
  box-shadow:0 4px 20px rgba(26,122,82,.22);
}
.school-banner::before{content:'';position:absolute;inset:0;background:var(--dots);opacity:.5}
.school-banner::after{
  content:'';position:absolute;right:-40px;top:-40px;
  width:180px;height:180px;border-radius:50%;
  border:28px solid rgba(255,255,255,.07);
}
.school-banner-left{position:relative;z-index:1}
.school-banner h2{font-family:'Lora',serif;font-size:19px;font-weight:600;color:#fff;margin-bottom:3px;letter-spacing:-.02em}
.school-banner p{font-size:13px;color:rgba(255,255,255,.7)}
.school-banner-right{position:relative;z-index:1;display:flex;gap:20px}
.banner-stat{text-align:center;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:12px;padding:12px 18px}
.banner-stat-val{font-family:'Lora',serif;font-size:26px;font-weight:700;color:#fff;line-height:1}
.banner-stat-lbl{font-size:10px;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.07em;margin-top:4px}

/* ─── Rooms Grid ─── */
.rooms-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-top:20px}
.room-card{
  background:var(--card);border:1.5px solid var(--border);
  border-radius:18px;padding:26px;cursor:pointer;
  transition:all .25s cubic-bezier(.34,1.2,.64,1);
  position:relative;overflow:hidden;
  box-shadow:var(--shadow);
  animation:fadeUp .4s ease both;
}
.room-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:5px;
  background:var(--c);border-radius:5px 5px 0 0;
}
/* Soft color wash in top-right corner */
.room-card::after{
  content:'';position:absolute;top:0;right:0;
  width:80px;height:80px;border-radius:0 18px 0 80px;
  background:var(--c);opacity:.07;
  transition:opacity .25s;
}
.room-card:hover{
  border-color:var(--c);
  transform:translateY(-4px) scale(1.01);
  box-shadow:var(--shadow-md);
}
.room-card:hover::after{opacity:.12}
.room-card-icon{
  width:50px;height:50px;border-radius:14px;
  display:grid;place-items:center;margin-bottom:18px;
}
.room-card h3{font-family:'Lora',serif;font-size:20px;font-weight:700;margin-bottom:3px;letter-spacing:-.02em}
.room-card p{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.07em}
.room-card .student-count{margin-top:16px;font-size:13px;font-weight:700;color:var(--c)}

.add-room-card{
  background:transparent;border:2px dashed var(--border);
  border-radius:18px;padding:24px;cursor:pointer;transition:all .22s;
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;min-height:175px;gap:12px;
  color:var(--muted);font-weight:600;font-family:'Sora',sans-serif;font-size:14px;
}
.add-room-card:hover{border-color:var(--accent);color:var(--accent);background:var(--teal-light)}

/* ─── Modal ─── */
.modal-overlay{
  position:fixed;inset:0;background:rgba(10,30,20,.5);
  display:flex;align-items:center;justify-content:center;
  z-index:999;padding:20px;backdrop-filter:blur(8px);
}
.modal-overlay.hidden{display:none}
.modal{
  background:var(--card);border:1.5px solid var(--border);
  border-radius:22px;padding:34px;width:100%;max-width:460px;
  box-shadow:0 24px 64px rgba(26,122,82,.18);
  animation:scaleIn .22s ease both;
}
.modal h2{font-family:'Lora',serif;font-size:22px;font-weight:700;margin-bottom:24px;letter-spacing:-.02em}
.modal-actions{display:flex;gap:10px;margin-top:24px}
.btn-secondary{
  flex:1;padding:12px;background:var(--bg);color:var(--text);
  border:1.5px solid var(--border);border-radius:11px;
  font-family:'Sora',sans-serif;font-size:14px;font-weight:600;
  cursor:pointer;transition:all .2s;
}
.btn-secondary:hover{border-color:var(--accent);color:var(--accent)}
.color-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:8px}
.color-swatch{
  width:36px;height:36px;border-radius:10px;cursor:pointer;
  border:3px solid transparent;transition:all .18s;
}
.color-swatch.selected{border-color:var(--text);transform:scale(1.15);box-shadow:0 2px 8px rgba(0,0,0,.2)}

/* ─── Dashboard ─── */
.db-header{
  padding:32px 36px 0;display:flex;align-items:flex-start;
  justify-content:space-between;gap:16px;flex-wrap:wrap;
}
.db-back{
  display:flex;align-items:center;gap:6px;background:none;border:none;
  color:var(--muted);cursor:pointer;font-family:'Sora',sans-serif;
  font-size:13px;font-weight:600;padding:0;margin-bottom:10px;
  transition:color .2s;
}
.db-back:hover{color:var(--accent)}
.db-title{font-family:'Lora',serif;font-size:28px;font-weight:700;letter-spacing:-.03em}
.db-subtitle{color:var(--muted);font-size:13px;margin-top:3px}
.db-date-pill{
  background:var(--surface);border:1.5px solid var(--border);
  border-radius:11px;padding:9px 15px;font-size:13px;font-weight:600;
  display:flex;align-items:center;gap:8px;color:var(--muted);flex-shrink:0;
}

/* Stats chips */
.stats-row{display:flex;gap:12px;margin-top:22px;flex-wrap:wrap}
.stat-chip{
  flex:1;min-width:100px;background:var(--card);border:1.5px solid var(--border);
  border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:4px;
  box-shadow:var(--shadow);transition:transform .2s;
}
.stat-chip:hover{transform:translateY(-2px)}
.stat-chip .val{font-family:'Lora',serif;font-size:32px;font-weight:700;letter-spacing:-.03em}
.stat-chip .lbl{font-size:10px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.08em}

/* Progress */
.progress-wrap{
  margin-top:16px;background:var(--card);
  border-radius:16px;border:1.5px solid var(--border);padding:18px 22px;
  box-shadow:var(--shadow);
}
.progress-top{display:flex;justify-content:space-between;margin-bottom:10px;font-size:13px;color:var(--muted);font-weight:600}
.progress-bar{height:10px;background:var(--teal-light);border-radius:10px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,#1A7A52,#2DB57C);border-radius:10px;transition:width .5s cubic-bezier(.34,1.2,.64,1)}

/* Student table */
.students-table{margin-top:24px}
.table-toolbar{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:14px;flex-wrap:wrap;gap:10px;
}
.table-toolbar h3{font-family:'Lora',serif;font-size:20px;font-weight:700;letter-spacing:-.02em}
.toolbar-actions{display:flex;gap:8px}
.btn-sm{
  padding:9px 15px;border-radius:10px;font-family:'Sora',sans-serif;
  font-size:13px;font-weight:700;cursor:pointer;border:none;
  display:inline-flex;align-items:center;gap:6px;transition:all .2s;
}
.btn-sm.primary{background:var(--accent);color:#fff;box-shadow:0 2px 10px rgba(26,122,82,.25)}
.btn-sm.primary:hover{background:#156641;transform:translateY(-1px)}
.btn-sm.ghost{background:var(--surface);color:var(--text);border:1.5px solid var(--border)}
.btn-sm.ghost:hover{border-color:var(--accent);color:var(--accent)}
.btn-sm.success{
  background:rgba(26,122,82,.1);color:var(--green);
  border:1.5px solid rgba(26,122,82,.22);
}
.btn-sm.success:hover{background:rgba(26,122,82,.18)}

/* Student rows */
.student-row{
  background:var(--card);border:1.5px solid var(--border);
  border-radius:14px;padding:14px 18px;
  display:flex;align-items:center;gap:14px;margin-bottom:8px;
  transition:all .2s;box-shadow:var(--shadow);
}
.student-row:hover{box-shadow:var(--shadow-md);border-color:var(--accent);transform:translateX(3px)}
.s-avatar{
  width:42px;height:42px;border-radius:12px;
  display:grid;place-items:center;font-size:13px;font-weight:700;
  color:#fff;flex-shrink:0;
}
.s-name{font-size:15px;font-weight:600;flex:1}
.s-id{font-size:11px;color:var(--muted);margin-top:1px}

/* Attendance buttons */
.att-btns{display:flex;gap:6px}
.att-btn{
  width:38px;height:38px;border-radius:10px;border:1.5px solid;
  display:grid;place-items:center;cursor:pointer;
  transition:all .18s;background:transparent;
}
.att-btn.present{border-color:#1A7A52;color:#1A7A52}
.att-btn.present.active{background:#1A7A52;color:#fff;box-shadow:0 2px 10px rgba(26,122,82,.35)}
.att-btn.late{border-color:#D4860A;color:#D4860A}
.att-btn.late.active{background:#D4860A;color:#fff;box-shadow:0 2px 10px rgba(212,134,10,.3)}
.att-btn.absent{border-color:#D63F3F;color:#D63F3F}
.att-btn.absent.active{background:#D63F3F;color:#fff;box-shadow:0 2px 10px rgba(214,63,63,.3)}
.att-btn:hover{transform:scale(1.12)}

/* Badges */
.status-badge{
  font-size:10px;font-weight:700;padding:4px 10px;
  border-radius:20px;text-transform:uppercase;letter-spacing:.07em;
}
.status-badge.present{background:#DFFAEF;color:#156641;border:1px solid #A8DBBF}
.status-badge.late{background:#FFF4E0;color:#9A5E06;border:1px solid #F0C878}
.status-badge.absent{background:#FDEAEA;color:#A82D2D;border:1px solid #F4BBBB}
.status-badge.none{background:var(--bg);color:var(--muted);border:1px solid var(--border)}

.delete-btn{
  width:34px;height:34px;border-radius:9px;border:1.5px solid var(--border);
  background:transparent;color:var(--muted);cursor:pointer;
  display:grid;place-items:center;transition:all .2s;
}
.delete-btn:hover{border-color:var(--red);color:var(--red);background:#FDF1F1}
.empty-state{text-align:center;padding:56px 24px;color:var(--muted)}

/* ─── Toast ─── */
.toast{
  position:fixed;bottom:28px;right:28px;
  background:linear-gradient(135deg,#1A7A52,#229966);
  color:#fff;padding:13px 20px;border-radius:14px;font-size:14px;font-weight:600;
  display:flex;align-items:center;gap:10px;
  box-shadow:0 8px 28px rgba(26,122,82,.4);
  transform:translateY(80px);opacity:0;
  transition:all .38s cubic-bezier(.34,1.56,.64,1);
  z-index:1000;pointer-events:none;
}
.toast.show{transform:translateY(0);opacity:1}

/* ─── Utility ─── */
.view{display:none}
.view.active{display:block}
#app{display:none}
#app.active{display:flex}

@media(max-width:760px){
  .auth-left{display:none}
  .auth-right{padding:32px 24px}
  .sidebar{width:200px}
  .content{padding:20px 20px 48px}
  .main-header{padding:24px 20px 0}
  .db-header{padding:24px 20px 0}
}
